# Large site plan used as the profiling workload (wayfinder ticket #255).
# ~2400 x 4050 m district: terrain, 12 sub-districts of streets/blocks/lots with
# mixed typologies (row, detached, courtyard, slab), street-tree rows, Miyawaki patches.
# Run from the repo root:
#   ItsJustCAD --run examples/scripts/perf-site.script --headless --out /tmp/perf-site.itsjustcad.json
#
# Each sub-district works on its own layer. The lot verbs act on every unlocked closed
# curve, so the boundary, blocks and setbacks layers are locked before the next verb
# runs, and the finished lots/blocks/buildings layers are renamed and locked so the next
# sub-district starts clean. Lots are not draped on the terrain (no verb for that),
# so terrain above z=0 shows through between buildings.
#
# Builds in about 130 s on an M-series Mac (release). Most of that is planting:
# every plant scans the whole document to find the terrain (see #256).
units m
location 3.45 -76.53 -5
terrain examples/scripts/perf-site-terrain.csv

# d1: row
layer d1
rect 0,0,0 780 990
lotgeneratesite last orthogonal roadwidth=14 blockdepth=70 seed=1
layerlock d1 on
lotsubdivide all grid area=300 width=10 seed=1
layerlock blocks on
lotsetbacks all front=3 side=0 rear=4
layerlock setbacks on
lotbuilding all typology=row floors=3 roof=gable pitch=30
layerrename lots lots-d1
layerlock lots-d1 on
layerrename blocks blocks-d1
layerrename setbacks setbacks-d1
layerrename buildings buildings-d1
layerlock buildings-d1 on

# d2: detached
layer d2
rect 810,0,0 780 990
lotgeneratesite last orthogonal roadwidth=14 blockdepth=70 seed=2
layerlock d2 on
lotsubdivide all grid area=600 width=18 seed=2
layerlock blocks on
lotsetbacks all front=5 side=2 rear=5
layerlock setbacks on
lotbuilding all typology=detached floors=2 roof=hip pitch=25
layerrename lots lots-d2
layerlock lots-d2 on
layerrename blocks blocks-d2
layerrename setbacks setbacks-d2
layerrename buildings buildings-d2
layerlock buildings-d2 on

# d3: row
layer d3
rect 1620,0,0 780 990
lotgeneratesite last orthogonal roadwidth=14 blockdepth=70 seed=3
layerlock d3 on
lotsubdivide all grid area=300 width=10 seed=3
layerlock blocks on
lotsetbacks all front=3 side=0 rear=4
layerlock setbacks on
lotbuilding all typology=row floors=3 roof=gable pitch=30
layerrename lots lots-d3
layerlock lots-d3 on
layerrename blocks blocks-d3
layerrename setbacks setbacks-d3
layerrename buildings buildings-d3
layerlock buildings-d3 on

# d4: courtyard
layer d4
rect 0,1020,0 780 990
lotgeneratesite last orthogonal roadwidth=14 blockdepth=90 seed=4
layerlock d4 on
lotsubdivide all grid area=1600 width=36 seed=4
layerlock blocks on
lotsetbacks all front=3 side=0 rear=3
layerlock setbacks on
lotbuilding all typology=courtyard floors=4 roof=flat
layerrename lots lots-d4
layerlock lots-d4 on
layerrename blocks blocks-d4
layerrename setbacks setbacks-d4
layerrename buildings buildings-d4
layerlock buildings-d4 on

