# Street trees along the arterials and the perimeter.
layer green
plantrow samanea-saman 795,0 795,4050 15
plantrow samanea-saman 1605,0 1605,4050 15
plantrow samanea-saman 0,1005 2400,1005 15
plantrow samanea-saman 0,2025 2400,2025 15
plantrow samanea-saman 0,3045 2400,3045 15
plantrow roystonea-regia -10,0 -10,4050 12
plantrow roystonea-regia 2410,0 2410,4050 12
plantrow roystonea-regia 0,-10 2400,-10 12
plantrow roystonea-regia 0,4060 2400,4060 12

# Miyawaki pocket forests at the arterial crossings. Keep them small: each sapling
# costs a full document scan, so a patch costs saplings x objects (see #255/#256).
rect 789,999,0 12 12
miyawaki last 3
rect 789,2019,0 12 12
miyawaki last 3
rect 789,3039,0 12 12
miyawaki last 3
rect 1599,999,0 12 12
miyawaki last 3
rect 1599,2019,0 12 12
miyawaki last 3
rect 1599,3039,0 12 12
miyawaki last 3
top
ze
