layerlock blocks on
lotsetbacks all front=6 side=4 rear=6
layerlock setbacks on
lotbuilding all typology=slab floors=8 roof=flat
layerrename lots lots-d5
layerlock lots-d5 on
layerrename blocks blocks-d5
layerrename setbacks setbacks-d5
layerrename buildings buildings-d5
layerlock buildings-d5 on

